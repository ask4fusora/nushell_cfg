# Generated by `generate completions` from:
# - `carapace fd export`
# - `fd --help`
# Flags that are not declared here still reach `fd`. Arguments without a completer
# here are completed by the external completer in $env.config.completions.external.

module extern {

    # find entries in the filesystem
    #
    # Not declared (optional value or unsupported name): --hyperlink, --strip-cwd-prefix
    # Sources disagree on whether --regex takes a value, so it's a switch: yes in `carapace fd export`, no in `fd --help`
    @complete external
    @structured [] { lines }
    export extern "fd" [
        -1                             # Limit to one result
        --absolute-path(-a)            # Show absolute instead of relative paths
        --and: string                  # Add additional required search patterns
        --base-directory(-C): string   # Change the base directory
        --batch-size: string           # Maximum number of arguments for batch commands
        --case-sensitive(-s)           # Case-sensitive search (default: smart case)
        --change-newer-than: string    # alias for --changed-within
        --change-older-than: string    # alias for --changed-before
        --changed-after: string        # alias for --changed-within
        --changed-before: string       # Filter by file modification time (older than)
        --changed-within: string       # Filter by file modification time (newer than)
        --color(-c): string@[auto always never] # When to use colors
        --exact-depth: string          # When to use colors
        --exclude(-E): string          # Exclude entries that match the given glob pattern
        --exec(-x): string             # Execute a command for each search result
        --exec-batch(-X): string       # Execute a command with all search results at once
        --extension(-e): string        # Filter by file extension
        --fixed-strings(-F)            # fixed string search
        --follow(-L)                   # Follow symbolic links
        --format: string               # Print results according to template
        --full-path(-p)                # Search full path (default: file-/dirname only)
        --glob(-g)                     # Glob-based search (default: regular expression)
        --help(-h)                     # Prints help information
        --hidden(-H)                   # Search hidden files and directories
        --ignore-case(-i)              # Case-insensitive search (default: smart case)
        --ignore-contain: string       # Ignore directories containing the named entry
        --ignore-file: string          # Add a custom ignore file.
        --list-details(-l)             # Use a long listing format with file metadata
        --max-depth(-d): string        # Set maximum search depth (default: none)
        --max-results: string          # Limit the number of results
        --min-depth: string            # Set minimum search depth (default: none)
        --newer: string                # alias for --changed-within
        --no-ignore(-I)                # Do not respect .(git|fd)ignore files
        --no-ignore-parent             # Ignore parent directory's .gitignore
        --no-ignore-vcs                # Ignore .gitignore files
        --no-require-git               # Do not require a git repository to respect gitignores
        --older: string                # alias for --changed-before
        --one-file-system              # Stay within the same file system
        --owner(-o): string            # Filter by owning user and/or group
        --path-separator: string       # Set the path separator
        --print0(-0)                   # Separate results by the null character
        --prune                        # Do not recurse into matching directories
        --quiet(-q)                    # Quiet mode
        --regex                        # Regular expression search
        --search-path: string          # Provide paths to search
        --show-errors                  # Show filesystem errors
        --size(-S): string             # Limit results based on the size of files.
        --threads(-j): string          # Set number of threads
        --type(-t): string             # Filter by type
        --unrestricted(-u)             # Unrestricted Search
        --version(-V)                  # Prints version information
        --exact                        # Perform an exact match.
    ]
}

export use extern *
